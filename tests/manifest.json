    "ratio": {
      "conformance": "approximate",
      "conformance_reason": "exp(median(log x_i - log y_j)). The logarithm and the exponential come from each language's own libm, and two implementations correct to within an ulp still disagree in the last bit. Perturbing them moves the result on 94% of inputs, by up to 3 ulp.",
      "directory": "ratio",
      "generator": "cs/Pragmastat.TestGenerator",
      "pattern": "*.json",
      "description": "Ratio (two-sample) estimator tests",
      "languages": ["cs", "go", "kt", "py", "r", "rs", "ts"]
    },
    "ratio-bounds": {
      "conformance": "approximate",
      "conformance_reason": "Same log-exp transform as ratio, with the margin selection on top. Perturbing the libm moves the result on 96% of inputs, by up to 16 ulp; the selection itself does not flip.",
      "directory": "ratio-bounds",
      "generator": "cs/Pragmastat.TestGenerator",
      "pattern": "*.json",
      "description": "RatioBounds confidence interval tests",
      "languages": ["cs", "go", "kt", "py", "r", "rs", "ts"]
    },
