{
  "version": 1,
  "description": "Machine-readable index of all cross-language reference test suites",
  "conformance_notes": {
    "exact": "The seven implementations must return identical bits. Loaders compare raw binary64 payloads, not a tolerance.",
    "approximate": "The seven agree to the tolerance recorded with the suite. The reason is stated per suite; it is always a library function the specification does not fix, never accumulated arithmetic error.",
    "why": "IEEE 754 fixes the result of each operation but not how many operations an implementation performs. A tolerance is the right instrument only where the output is continuous in the input; where the output is an element selected out of a set, a divergence is not a small error but a different element, and no epsilon bounds it.",
    "how_established": "Measured, not assumed: each estimator is recomputed with every call to log, exp, pow and cos returning the neighbouring representable value, the smallest difference two conforming libm implementations can have. An estimator whose output never moves under that perturbation cannot diverge for this reason in any language. sqrt is deliberately not perturbed: IEEE 754 requires it correctly rounded."
  },
  "suites": {
    "rng": {
      "conformance": "exact",
      "directory": "rng",
      "generator": "rs/pragmastat/examples/gen_rng_tests.rs",
      "description": "Random number generator reproducibility tests",
      "sub_suites": {
        "uniform-seed": {
          "pattern": "uniform-seed-*.json",
          "description": "Uniform f64 [0,1) from integer seeds",
          "languages": ["cs", "go", "kt", "py", "r", "rs", "ts"]
        },
        "uniform-f32": {
          "pattern": "uniform-f32-*.json",
          "description": "Uniform f32 [0,1) from integer seeds",
          "languages": ["cs", "go", "kt", "rs"]
        },
        "uniform-int": {
          "pattern": "uniform-int-*.json",
          "description": "Uniform i64 in [min, max)",
          "languages": ["cs", "go", "kt", "py", "r", "rs", "ts"]
        },
        "uniform-i32": {
          "pattern": "uniform-i32-*.json",
          "description": "Uniform i32 in [min, max)",
          "languages": ["cs", "go", "kt", "rs"]
        },
        "uniform-bool": {
          "pattern": "uniform-bool-*.json",
          "description": "Uniform boolean generation",
          "languages": ["cs", "go", "kt", "py", "r", "rs", "ts"]
        },
        "uniform-string": {
          "pattern": "uniform-string-*.json",
          "description": "Uniform f64 [0,1) from string seeds (FNV-1a)",
          "languages": ["cs", "go", "kt", "py", "r", "rs", "ts"]
        },
        "uniform-range": {
          "pattern": "uniform-range-*.json",
          "description": "Uniform f64 in [min, max)",
          "languages": ["cs", "go", "kt", "py", "r", "rs", "ts"]
        }
      }
    },
